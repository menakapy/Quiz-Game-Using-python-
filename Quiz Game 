# Python Quiz Game

questions = [
    {
        "question": "1. What does CPU stand for?",
        "options": ["A. Central Processing Unit",
                    "B. Computer Processing Unit",
                    "C. Central Program Unit",
                    "D. Control Processing Unit"],
        "answer": "A"
    },
    {
        "question": "2. Which keyword is used to define a function in Python?",
        "options": ["A. function", "B. def", "C. fun", "D. define"],
        "answer": "B"
    },
    {
        "question": "3. Which data type stores multiple values?",
        "options": ["A. int", "B. float", "C. list", "D. string"],
        "answer": "C"
    },
    {
        "question": "4. Which symbol is used for comments in Python?",
        "options": ["A. //", "B. <!--", "C. #", "D. **"],
        "answer": "C"
    },
    {
        "question": "5. Which loop is used to iterate over a sequence?",
        "options": ["A. while", "B. repeat", "C. do-while", "D. for"],
        "answer": "D"
    }
]

score = 0

print("=" * 40)
print("      PYTHON QUIZ GAME")
print("=" * 40)

for q in questions:
    print("\n" + q["question"])
    for option in q["options"]:
        print(option)

    user = input("Enter your answer (A/B/C/D): ").strip().upper()

    if user == q["answer"]:
        print("Correct!")
        score += 1
    else:
        print("Wrong!")
        print("Correct Answer:", q["answer"])

print("\n" + "=" * 40)
print("Quiz Completed")
print("Your Score:", score, "/", len(questions))

percentage = (score / len(questions)) * 100
print("Percentage:", percentage, "%")

if percentage >= 80:
    print("Excellent!")
elif percentage >= 60:
    print("Good Job!")
elif percentage >= 40:
    print("Keep Practicing!")
else:
    print("Better Luck Next Time!")